# ============================================================
# Vertiche Backend - Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# .env NO se commitea (ver .gitignore).
# ============================================================

# Servidor
PORT=8080
NODE_ENV=development
PREFIX_NAME=

# CORS (lista separada por comas)
# Front local (Vite) corre por defecto en 5173.
# Agrega el origen de staging/prod aquí cuando lo conozcas.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=VerticheSortFlow_DEV_DB

# AWS Cognito (auth)
# Sólo necesario si vas a tocar las rutas /Auth/*.
# Para dev local sin Cognito, deja estos vacíos y el frontend usará mockSignIn.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
