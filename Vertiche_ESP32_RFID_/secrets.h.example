//Crear archivo secrets.h y reemplazar con valores
#ifndef SECRETS_H
#define SECRETS_H

// ── Wi-Fi ───────────────────────────────────────────────────────────────────
#define WIFI_SSID     "nombre_de_tu_red"
#define WIFI_PASSWORD "contraseña_wifi"

// ── Backend Vertiche ────────────────────────────────────────────────────────
// IP o dominio del backend (incluye http:// y puerto si aplica).
// Ejemplo producción: "http://3.221.34.193:8080"
// Ejemplo local:      "http://192.168.1.100:8080"
#define API_HOST      "http://<IP_O_DOMINIO>:8080"

// ── AWS Cognito ─────────────────────────────────────────────────────────────
// Credenciales de un usuario de tipo BAY_OPERATOR (o el rol que corresponda
// al lector físico). Se usa flujo USER_PASSWORD_AUTH.
#define COGNITO_REGION    "us-east-1"
#define COGNITO_CLIENT_ID "<cognito_app_client_id>"
#define COGNITO_USERNAME  "<usuario_cognito>@vertiche.local"
#define COGNITO_PASSWORD  "<contraseña_del_usuario_cognito>"

#endif // SECRETS_H
